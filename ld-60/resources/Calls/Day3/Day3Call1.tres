[sub_resource type="Resource" id="Resource_qcfhm"]
script = ExtResource("1_f3s82")
speaker = ExtResource("1_qcfhm")
text = "Good Morning! I need to call Peter."
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_llkjr"]
script = ExtResource("1_f3s82")
speaker = ExtResource("1_qcfhm")
text = "Hello Peter! I have heard that someone broke into your house as well! Do you know when that happened and if anything was stolen?"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_pwu4m"]
script = ExtResource("1_f3s82")
speaker = ExtResource("3_y0mv0")
text = "Hello Sarah! Someone entered my house around 3 pm and while there was utter chaos in the living room, nothing was stolen! I'm quite surprised by this."
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_700ay"]
script = ExtResource("1_f3s82")
speaker = ExtResource("1_qcfhm")
text = "Around 3pm you say? I saw your nephew James around this time in your garden..."
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_y0mv0"]
script = ExtResource("1_f3s82")
speaker = ExtResource("3_y0mv0")
text = "Really? I might need to ask him then if he's seen anything. Thank you!"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

