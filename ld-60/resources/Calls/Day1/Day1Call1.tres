[sub_resource type="Resource" id="Resource_mwg6r"]
script = ExtResource("2_mqq7o")
speaker = ExtResource("1_2kfyn")
text = "Oh hello, Deary! I wish to speak to my good friend Sarah Butler, but I have misplaced my address book with her number! Could you be so kind and put me through to her? I have wonderful news I need to share!"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_c2w2d"]
script = ExtResource("2_mqq7o")
speaker = ExtResource("3_plafl")
text = "Hello Marge! Haven't heard from you in a while, how are you?"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_e3gdm"]
script = ExtResource("2_mqq7o")
speaker = ExtResource("1_2kfyn")
text = "Hello Sarah, dear, I am great!
My grandson Matty has brought me a large bag of nice groceries for the week!"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_mdyqm"]
script = ExtResource("2_mqq7o")
speaker = ExtResource("3_plafl")
text = "Oh that is nice of him! 
Listen, I have heard that Casey's nephew Richard went missing yesterday at 5pm from his front porch in Holloward!"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_nwd11"]
script = ExtResource("2_mqq7o")
speaker = ExtResource("1_2kfyn")
text = "Oh no, that is horrible!  
I have heard that a bank across his home was robbed at the same time. Perhaps there's a connection?"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_31lrl"]
script = ExtResource("2_mqq7o")
speaker = ExtResource("3_plafl")
text = "Could be, but... Oh! Oh no, my pie is burning in the oven! I have to go now, Marge, goodbye!"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[resource]
