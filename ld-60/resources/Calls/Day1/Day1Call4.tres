[sub_resource type="Resource" id="Resource_twya3"]
script = ExtResource("1_3lea6")
speaker = ExtResource("1_twya3")
text = "Hello, I want to call Brian Howard. Have forgotten his number though, if you would be so nice."
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_afbhg"]
script = ExtResource("1_3lea6")
speaker = ExtResource("1_twya3")
text = "Hi Brian, Willi here. Have you heard that the police presence in Holloward is really high right now?"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_vyvvp"]
script = ExtResource("1_3lea6")
speaker = ExtResource("3_afbhg")
text = "Hey Willi! Yes I have heard. Good thing that Susan and I aren't there anymore with our guest."
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_xbpkw"]
script = ExtResource("1_3lea6")
speaker = ExtResource("1_twya3")
text = "Yes! It was good though to see you and Susan in Holloward yesterday! Haven't seen you in a while."
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_87tlh"]
script = ExtResource("1_3lea6")
speaker = ExtResource("3_afbhg")
text = "Oh right, you haven't seen us in a long time! Listen, Susan's calling. Some problem with our guest. See you!"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[resource]
