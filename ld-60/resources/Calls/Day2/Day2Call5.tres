[sub_resource type="Resource" id="Resource_j630x"]
script = ExtResource("1_afxn6")
speaker = ExtResource("1_j630x")
text = "Ah hello again. I want to call my sister. Her number is 5242."
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_3fpax"]
script = ExtResource("1_afxn6")
speaker = ExtResource("1_j630x")
text = "Hey Lena, you know who the talented artist behind the new town hall incident is?"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_58a6g"]
script = ExtResource("1_afxn6")
speaker = ExtResource("3_3fpax")
text = "Hi Willi! No I don't know, but Paul's friend Matty might know them. I have heard them talking about it recently.
Anyway, is the Holloward money still safe?"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_0edql"]
script = ExtResource("1_afxn6")
speaker = ExtResource("1_j630x")
text = "Hush! Don't talk about it!  
But yes, it's still safe. Got to go now, bye!"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

