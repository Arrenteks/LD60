[sub_resource type="Resource" id="Resource_1m5tu"]
script = ExtResource("1_41jb3")
speaker = ExtResource("1_1m5tu")
text = "Hey, I want to call Laura. Her number is 4268."
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_6s5l6"]
script = ExtResource("1_41jb3")
speaker = ExtResource("1_1m5tu")
text = "Hey babe! I have seen your latest artwork, congratulations on it and its success!"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_l632f"]
script = ExtResource("1_41jb3")
speaker = ExtResource("3_6s5l6")
text = "Aw, thank you! But it could have been better, the rain smeared a few letters."
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_bsnpo"]
script = ExtResource("1_41jb3")
speaker = ExtResource("1_1m5tu")
text = "Oh, don't worry, it's still amazing!"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_r1fww"]
script = ExtResource("1_41jb3")
speaker = ExtResource("3_6s5l6")
text = "Yea, thanks! Oh, by the way, Jean is still up to help you guys tomorrow!"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_ivi25"]
script = ExtResource("1_41jb3")
speaker = ExtResource("1_1m5tu")
text = "Great, that's good! I have to go now, love ya!"
