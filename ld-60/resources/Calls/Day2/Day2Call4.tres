[sub_resource type="Resource" id="Resource_q2kn5"]
script = ExtResource("1_ilfpl")
speaker = ExtResource("1_q2kn5")
text = "Heyo! Could you connect me to Laura Tyler please?"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_fw0do"]
script = ExtResource("1_ilfpl")
speaker = ExtResource("1_q2kn5")
text = "Heyo! Have you heard the news about the bank robbers in Bellport already? The police know nothing about the method of entry yet!"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_lpxwo"]
script = ExtResource("1_ilfpl")
speaker = ExtResource("3_okthv")
text = "Of course! Why do you even ask?
I still find it quite impressive that they climbed through the small vents to get into the bank!"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_okthv"]
script = ExtResource("1_ilfpl")
speaker = ExtResource("1_q2kn5")
text = "Oh yea, that sounds quite impressive!  
Listen, I need to go now, bye!"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

