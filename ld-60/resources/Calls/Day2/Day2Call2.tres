[sub_resource type="Resource" id="Resource_y1h7d"]
script = ExtResource("1_h1snn")
speaker = ExtResource("1_y1h7d")
text = "Hello! I wish to call Willi, you should know his number."
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_3y5cp"]
script = ExtResource("1_h1snn")
speaker = ExtResource("1_y1h7d")
text = "Hey Willi, did you know that your Nephew Paul and his friend Matty were in Bellport?"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_nnelo"]
script = ExtResource("1_h1snn")
speaker = ExtResource("3_3y5cp")
text = "Yeah, I do. They're still here, currently staying at my house till it's calmer outside. They will return home later.
How's Susan doing with the new guest?"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[sub_resource type="Resource" id="Resource_h1d6b"]
script = ExtResource("1_h1snn")
speaker = ExtResource("1_y1h7d")
text = "Quite well, but he ran earlier for a bit. Talking about him, I have to go to Susan, help relocate him. See ya!"
metadata/_custom_type_script = "uid://dkijwy1pq2wnf"

[resource]
